              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Bootstrap"
                }
              }
            }
          },
          "401": {
            "description": "Нет действующей сессии или ключа"
          },
          "404": {
            "description": "Запись отсутствует или принадлежит другому профилю"
          },
          "429": {
            "description": "Слишком много запросов"
          }
        },
        "security": []
      }
    },
