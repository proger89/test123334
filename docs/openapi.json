            }
          },
          "competencies": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/Competency"
            }
          }
        },
        "required": [
          "score",
          "passed",
          "critical",
          "checks",
          "rubric",
          "events",
          "competencies"
        ],
        "additionalProperties": false
