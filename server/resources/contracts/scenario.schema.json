{
  "type": "object",
  "properties": {
    "id": {
      "enum": [
        "service",
        "security"
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "intro": {
      "type": "string",
      "minLength": 1
    },
    "seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600
    },
    "critical_timeout": {
      "type": "boolean"
    },
    "initial": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "rubric": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "competency": {
            "type": "string",
            "minLength": 1
          },
          "default": {
            "type": "boolean"
          }
        },
        "required": [
          "label",
          "competency"
        ],
        "additionalProperties": false
      }
    },
    "nodes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "explanation": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "next": {
                  "type": "string",
                  "minLength": 1
                },
                "open": {
                  "type": "string",
                  "minLength": 1
                },
                "loyalty": {
                  "type": "integer",
                  "minimum": -100,
                  "maximum": 100
                },
                "safety": {
                  "type": "integer",
                  "minimum": -100,
                  "maximum": 100
                },
                "when": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "boolean"
                  }
                },
                "flags": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "boolean"
                  }
                },
                "checks": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "boolean"
                  }
                },
                "critical": {
                  "type": "boolean"
                },
                "close_timer": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "label",
                "explanation",
                "source"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "text",
          "actions"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "version",
    "title",
    "intro",
    "seconds",
    "critical_timeout",
    "initial",
    "rubric",
    "nodes"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}